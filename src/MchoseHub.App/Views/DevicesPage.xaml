<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MchoseHub.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        Padding="{StaticResource PagePadding}"
        HorizontalScrollMode="Disabled"
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Spacing="16"
            MaxWidth="{StaticResource ContentMaxWidth}"
            HorizontalAlignment="Stretch">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="24" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <Border Style="{StaticResource AppCardStyle}">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8">
                        <TextBlock Text="设备中心" FontSize="28" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock
                            MaxWidth="650"
                            HorizontalAlignment="Left"
                            Style="{StaticResource AppCaptionStyle}"
                            Text="连接迈从键盘，设置灯光、按键、宏和性能参数。" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Center" MinWidth="150">
                        <Button
                            x:Name="ScanButton"
                            Content="重新扫描"
                            Click="OnScan"
                            Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Stretch" />
                        <Button
                            x:Name="OpenButton"
                            Content="进入设备"
                            Click="OnOpen"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource AppCardStyle}">
                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="可用设备" Style="{StaticResource AppCardTitleStyle}" />
                            <TextBlock
                                Style="{StaticResource AppCaptionStyle}"
                                Text="通过 USB 或 2.4G 接收器连接后，选择设备开始设置。" />
                        </StackPanel>
                        <ToggleSwitch
                            x:Name="ShowAllSwitch"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            OffContent="仅迈从设备"
                            OnContent="全部 HID"
                            Toggled="OnShowAllToggled" />
                    </Grid>

                    <ListView
                        x:Name="DeviceList"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged"
                        MinHeight="80"
                        MaxHeight="430"
                        Padding="0">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition IsStaggeringEnabled="False" />
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="70" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="14" Padding="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="42"
                                        Height="42"
                                        CornerRadius="10"
                                        Background="{ThemeResource AccentFillColorTertiaryBrush}">
                                        <Image Source="{ThemeResource HubKeyboardIconSource}" Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock
                                            Text="{Binding SubText}"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource AppPillStyle}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Badge}" Style="{StaticResource CaptionTextBlockStyle}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <InfoBar
                        x:Name="Notice"
                        IsOpen="False"
                        IsClosable="True"
                        Severity="Informational"
                        Title="提示" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource AppInsetCardStyle}" Padding="22">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="5">
                        <TextBlock Text="离线预览" Style="{StaticResource AppCardTitleStyle}" />
                        <TextBlock Text="使用 K87 示例数据编辑灯光、按键和宏，不写入真实设备。" Style="{StaticResource AppCaptionStyle}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="预览 K87" Click="OnPreviewKeyboard" VerticalAlignment="Center" Padding="20,10" />
                </Grid>
            </Border>
            <TextBlock Text="连接提示：将键盘切换至有线或 2.4G 模式，并关闭其他正在配置该键盘的驱动。" Style="{StaticResource AppCaptionStyle}" Margin="4,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
